# Wargio Anna Edition — Environment Variables
# Copy to .env for local Executa development. NEVER commit .env

# Demo MongoDB only — NOT production wargio_demo
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=wargio_anna_demo

# Disable MCP live stdio (same as Wargio production default)
MCP_LIVE_ENABLED=false

# Optional — only if keeping Gemini embeddings in Executa (Phase 2)
# GEMINI_API_KEY=
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Default language when tool param omitted
WARGIO_DEFAULT_LANGUAGE=id

# Anna CLI PAT is stored separately at ~/.config/anna/credentials.json
# after: anna-app login --host https://anna.partners
